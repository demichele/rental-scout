# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mercado Libre — el scout busca la SERP HTML (no hace falta token).
# ping_meli sí lee MELI_ACCESS_TOKEN (API). Si regenerás OAuth, copiá ambos:
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=

# No pongas acá CLIENT_ID / CLIENT_SECRET / REDIRECT_URI.
# Esas tres van en Vercel (proyecto oauth), no las usa ping_meli ni run_once.
