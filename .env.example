# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mercado Libre — .env de Python (rental-scout). El scout solo lee el access token.
# Cuando la página OAuth te muestre los valores, copiá ambos:
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=

# No pongas acá CLIENT_ID / CLIENT_SECRET / REDIRECT_URI.
# Esas tres van en Vercel (proyecto oauth), no las usa ping_meli ni run_once.
